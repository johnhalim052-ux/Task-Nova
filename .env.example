# ==============================================================================
# TaskNova Environment Configuration Example
# Copy to .env for local/self-hosted Node.js deployment. NEVER commit .env.
# ==============================================================================

# Server & URL Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
# Comma-separated allowed origins for CORS when frontend is hosted separately (e.g., GitHub Pages)
CORS_ORIGINS="http://localhost:3000"

# Security & Session Signing (Set a strong random 64-char hex secret in production)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
# Optional: Require a secret key to claim the very first admin account on a fresh DB
ADMIN_BOOTSTRAP_KEY=""

# Cloud SQL / PostgreSQL Connection (Object Method - provided automatically in AI Studio Cloud SQL)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="tasknova"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_APP_PASSWORD"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# SMTP Email Delivery (Required for real email verification & password reset emails)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TaskNova <no-reply@tasknova.example>"

# PayPal Integration (Required for real employer checkout & worker PayPal payouts)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# USDT Custodial Payout Gateway (Required for real on-chain TRC20/ERC20 settlements)
USDT_API_URL=""
USDT_API_KEY=""
USDT_NETWORK="TRC20"
USDT_WALLET_ID=""

# Vodafone Cash Aggregator / PSP (Required for real Vodafone Cash disbursements)
VODAFONE_CASH_API_URL=""
VODAFONE_CASH_MERCHANT_ID=""
VODAFONE_CASH_API_KEY=""
VODAFONE_CASH_HMAC_SECRET=""
